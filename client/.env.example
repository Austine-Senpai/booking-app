# Copy this file to .env if you need to change these. Never commit .env.
# VITE_ variables are baked into the built website and visible to everyone —
# never put secrets in them.

# Full URL of the API, ONLY if the website is hosted on a different domain from the API.
# Leave empty in development (Vite proxies /api to http://localhost:5000) and when the
# API server hosts the website itself (the recommended setup, see README → Deploy).
VITE_API_URL=

# "true" shows the demo accounts on the login page (for a public portfolio demo only)
VITE_DEMO_MODE=false
# The admin login shown in demo mode — must match ADMIN_EMAIL / ADMIN_PASSWORD used to seed.
# It becomes PUBLIC in the website, so only ever use a throwaway demo password here.
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
