# Copy this file to .env if you need to change these. Never commit .env.

# Full URL of the API in production, e.g. https://my-api.onrender.com/api
# Leave empty in development — Vite proxies /api to http://localhost:5000
VITE_API_URL=

# Set to "true" to show the demo logins on the login page (Phase 9)
VITE_DEMO_MODE=false
