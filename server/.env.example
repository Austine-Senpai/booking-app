# Copy this file to .env and fill in the values. Never commit .env.

# "development" locally, "production" when deployed (enables secure cookies, hides error details)
NODE_ENV=development

# Port the API listens on (Vite proxies /api to this port in development)
PORT=5000

# MongoDB connection string — local MongoDB in development, Atlas in production
MONGODB_URI=mongodb://127.0.0.1:27017/booking-app

# Secret used to sign login tokens. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts before the user must log in again (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# URL of the React app — the only origin CORS will allow
CLIENT_URL=http://localhost:5173

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# SMTP settings for sending emails (Phase 5).
# Leave empty in development to use a free Ethereal test inbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address on outgoing emails
EMAIL_FROM="Booking App <no-reply@example.com>"
