# Copy this file to .env and fill in the values. Never commit .env.

# "development" locally, "production" when deployed (enables secure cookies, hides error details)
NODE_ENV=development

# Port the API listens on (Vite proxies /api to this port in development)
PORT=5000

# MongoDB connection string — local MongoDB in development, Atlas in production
MONGODB_URI=mongodb://127.0.0.1:27017/booking-app

# Secret used to sign login tokens. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How many days a login lasts before the user must log in again
JWT_EXPIRES_IN_DAYS=7

# URL of the React app — the only origin CORS will allow, and the base of links in emails.
# In production (where this server also hosts the React app) it's the site's own URL,
# e.g. https://booking-app.onrender.com
CLIENT_URL=http://localhost:5173

# Login cookie SameSite setting: leave as "lax". Use "none" ONLY if you host the client on a
# different domain from the API (Safari will then block logins — see utils/authCookie.js).
COOKIE_SAMESITE=lax

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# SMTP settings for sending booking emails.
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox instead
# (the preview link for each email is printed in the server log).
# In production, emails are skipped if SMTP_HOST is empty.
SMTP_HOST=
# 587 for most providers; 465 switches on "secure" mode automatically
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address emails are sent from. The sender NAME is the business name from settings.
EMAIL_FROM=no-reply@example.com
